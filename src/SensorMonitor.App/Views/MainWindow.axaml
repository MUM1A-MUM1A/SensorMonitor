<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SensorMonitor.App.ViewModels"
        x:Class="SensorMonitor.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Sensor Monitor Pro" Width="1200" Height="800"
        Background="#1E1E2E">

  <Grid RowDefinitions="Auto,*" Margin="20">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
      <StackPanel Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
        <TextBlock Text="Sensor Monitor" FontSize="28" FontWeight="Bold" Foreground="White"/>
        <Border Background="#313244" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
           <TextBlock Text="LIVE ML" Foreground="#A6E3A1" FontSize="12" FontWeight="Bold"/>
        </Border>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="250, *">
      <Border Grid.Column="0" Background="#181825" CornerRadius="15" Padding="15" Margin="0,0,20,0">
        <StackPanel Spacing="10">
          <TextBlock Text="МЕНЮ" Foreground="#A6ADC8" FontSize="12" FontWeight="Bold" Margin="5"/>
          <Button Content="Дашборд" Command="{Binding ShowDashboardCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Foreground="White" Padding="10"/>
          <Button Content="Графики" Command="{Binding ShowChartsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Foreground="White" Padding="10"/>
          <Button Content="Настройки" Command="{Binding ShowSettingsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Foreground="White" Padding="10"/>
        </StackPanel>
      </Border>

      <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
    </Grid>
  </Grid>
</Window>
