<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SensorMonitor.App.ViewModels"
        x:Class="SensorMonitor.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Sensor Monitor Pro" Width="1200" Height="800"
        Background="#1E1E2E">

  <Grid RowDefinitions="Auto,*" Margin="20">
    
    <!-- Шапка -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
      <StackPanel Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
        <TextBlock Text="Sensor Monitor" FontSize="28" FontWeight="Bold" Foreground="White"/>
        <Border Background="#313244" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
           <TextBlock Text="LIVE ML" Foreground="#A6E3A1" FontSize="12" FontWeight="Bold"/>
        </Border>
      </StackPanel>
    </Grid>

    <!-- Основной контент -->
    <Grid Grid.Row="1" ColumnDefinitions="250, *">
      
      <!-- Боковое меню -->
      <Border Grid.Column="0" Background="#181825" CornerRadius="15" Padding="15" Margin="0,0,20,0">
        <StackPanel Spacing="10">
          <TextBlock Text="МЕНЮ" Foreground="#A6ADC8" FontSize="12" FontWeight="Bold" Margin="5"/>
          <Button Content="Дашборд" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Foreground="White" Padding="10"/>
          <Button Content="Графики" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Foreground="White" Padding="10"/>
          <Button Content="Настройки" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Foreground="White" Padding="10"/>
        </StackPanel>
      </Border>

      <!-- Правая часть -->
      <Grid Grid.Column="1" RowDefinitions="Auto, *">
        
        <!-- Карточки с данными -->
        <Grid Grid.Row="0" ColumnDefinitions="*,*,*" Margin="0,0,0,20">
          
          <Border Background="#89B4FA" CornerRadius="15" Padding="20" Margin="0,0,10,0">
            <StackPanel>
              <TextBlock Text="Температура" Foreground="#11111B" FontWeight="Bold"/>
              <TextBlock Text="{Binding Temperature}" Foreground="#11111B" FontSize="36" FontWeight="Black" Margin="0,10,0,0"/>
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Background="#A6E3A1" CornerRadius="15" Padding="20" Margin="5,0,5,0">
            <StackPanel>
              <TextBlock Text="Влажность" Foreground="#11111B" FontWeight="Bold"/>
              <TextBlock Text="{Binding Humidity}" Foreground="#11111B" FontSize="36" FontWeight="Black" Margin="0,10,0,0"/>
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Background="{Binding StatusColor}" CornerRadius="15" Padding="20" Margin="10,0,0,0">
            <StackPanel>
              <TextBlock Text="Риск" Foreground="#11111B" FontWeight="Bold"/>
              <TextBlock Text="{Binding Risk}" Foreground="#11111B" FontSize="36" FontWeight="Black" Margin="0,10,0,0"/>
            </StackPanel>
          </Border>

        </Grid>

        <!-- Красивая заглушка вместо графика -->
        <Border Grid.Row="1" Background="#181825" CornerRadius="15" Padding="20">
          <Grid RowDefinitions="Auto, *">
             <TextBlock Text="Температура в реальном времени" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
             
             <Border Grid.Row="1" Background="#1E1E2E" CornerRadius="10" BorderBrush="#313244" BorderThickness="1">
                 <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                     <TextBlock Text="Live-график подключается..." Foreground="#A6ADC8" FontSize="16" HorizontalAlignment="Center"/>
                     <TextBlock Text="(Ожидание потока данных)" Foreground="#585B70" FontSize="12" HorizontalAlignment="Center"/>
                 </StackPanel>
             </Border>
          </Grid>
        </Border>

      </Grid>
    </Grid>
  </Grid>
</Window>
