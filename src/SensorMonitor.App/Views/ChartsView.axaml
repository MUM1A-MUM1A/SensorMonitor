<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SensorMonitor.App.ViewModels"
             x:Class="SensorMonitor.App.Views.ChartsView"
             x:DataType="vm:ChartsViewModel">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="{Binding Title}" FontSize="32" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock Text="Здесь будет большой и красивый график." Foreground="Gray" FontSize="18" Margin="0,10,0,0"/>
    </StackPanel>
</UserControl>
